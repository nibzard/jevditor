# Server (apps/server). Copy to your shell or process manager; nothing reads this file automatically.

# Bearer tokens → user ids. Required in production. In development, "dev-token" → "dev" is used.
JEVDITOR_TOKENS=change-me-long-token:alice

# TypeSafe (Jev). Without a key, development falls back to an offline demo classifier.
TYPESAFE_API_KEY=
# Pin the version your thresholds were tuned against. Aliases like jev-latest can move.
JEVDITOR_JEV_MODEL=jev-1.13.0
JEVDITOR_JEV_TIMEOUT_MS=1500
# Stay below the provider's documented 1,200 requests/minute.
JEVDITOR_JEV_RPM=1000
JEVDITOR_JEV_CONCURRENCY=32

# Claude, for rule drafting and rewrites only. Leave unset to turn both off.
ANTHROPIC_API_KEY=
JEVDITOR_CLAUDE_MODEL=claude-opus-5

JEVDITOR_DB=jevditor.db
PORT=8787

# Web (apps/web): token the browser sends. Defaults to dev-token.
VITE_JEVDITOR_TOKEN=
